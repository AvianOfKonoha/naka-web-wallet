{
  "name": "naka-fund-withdrawal",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "build:origin": "vite build --config vite.config.ts",
    "build:naka": "vite build --config vite.config.naka.ts",
    "deploy:origin": "gh-pages -d dist",
    "deploy:naka": "gh-pages -d dist --remote naka",
    "deploy:both": "pnpm run deploy:origin && pnpm run deploy:naka",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@metamask/sdk": "^0.33.1",
    "js-sha3": "^0.9.3",
    "pinia": "^3.0.3",
    "rlp": "^3.0.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.0",
    "vue3-toastify": "^0.2.8",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "@metamask/providers": "^22.1.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.10",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.7.0",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.10.6",
    "npm-run-all2": "^7.0.2",
    "sass": "^1.93.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.10",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "bracketSpacing": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "trailingComma": "none"
  }
}
